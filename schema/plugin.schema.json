{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nginxui/plugin-spec/schema/plugin.schema.json",
  "title": "NGINX UI plugin manifest",
  "description": "plugin.json, see https://nginxui.com/plugin/manifest. The structure mirrors the Manifest message of proto/nginxui/plugin/v1/manifest.proto and is tested against it (schema/README.md); the reference host validates it in internal/plugin/manifest.go.",
  "type": "object",
  "required": ["id", "name", "version", "api_version"],
  "additionalProperties": true,
  "anyOf": [
    { "required": ["server"] },
    { "required": ["webapp"] },
    { "required": ["content"] }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "dns01" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["dns01"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "http" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["http"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "notify" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["notify"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "probe" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["probe"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "mcp" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["mcp", "permissions"],
        "properties": { "permissions": { "contains": { "const": "mcp" } } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "storage" } } },
        "required": ["capabilities"]
      },
      "then": { "required": ["storage"] }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "cert.deploy" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["deploy", "permissions"],
        "properties": { "permissions": { "contains": { "const": "cert.deploy" } } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "security.blocklist" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["blocklist", "permissions"],
        "properties": { "permissions": { "contains": { "const": "network" } } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "upstream.discovery" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["discovery", "permissions"],
        "properties": { "permissions": { "contains": { "const": "network" } } }
      }
    },
    {
      "if": {
        "properties": { "capabilities": { "contains": { "const": "log.sink" } } },
        "required": ["capabilities"]
      },
      "then": {
        "required": ["permissions"],
        "properties": { "permissions": { "contains": { "const": "log.read" } } }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse domain plugin id. See https://nginxui.com/plugin/naming for the namespace rules."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Plugin version, Semantic Versioning 2.0.0."
    },
    "description": { "type": "string" },
    "i18n": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/locale" },
      "additionalProperties": { "$ref": "#/$defs/manifestI18n" },
      "description": "Translations of name and description keyed by host locale code."
    },
    "homepage_url": { "type": "string", "format": "uri" },
    "icon_path": { "$ref": "#/$defs/safeRelativePath" },
    "api_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Plugin API version. This version of the contract requires exactly 1."
    },
    "min_nginx_ui_version": { "type": "string" },
    "server": { "$ref": "#/$defs/manifestServer" },
    "webapp": { "$ref": "#/$defs/manifestWebapp" },
    "content": { "$ref": "#/$defs/manifestContent" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "enum": ["dns01", "http", "notify", "probe", "mcp", "storage", "cert.deploy", "security.blocklist", "upstream.discovery", "log.sink"] },
      "uniqueItems": true,
      "description": "Capabilities the plugin implements."
    },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/permission" },
      "description": "Permissions the plugin asks for. The user approves them before the plugin runs."
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifestRequirement" }
    },
    "requires_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Plugin ids that must not be enabled at the same time as this plugin. The check is symmetric: either side declaring it is enough."
    },
    "events": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Host events the plugin subscribes to, delivered through events.on."
    },
    "cron": {
      "type": "array",
      "items": { "$ref": "#/$defs/manifestCron" }
    },
    "network_hosts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dns01": { "$ref": "#/$defs/manifestDns01" },
    "http": { "$ref": "#/$defs/manifestHttp" },
    "settings_schema": {
      "oneOf": [
        { "$ref": "#/$defs/settingsSchema" },
        { "type": "null" }
      ]
    },
    "notify": { "$ref": "#/$defs/manifestNotify" },
    "probe": { "$ref": "#/$defs/manifestProbe" },
    "mcp": { "$ref": "#/$defs/manifestMcp" },
    "storage": { "$ref": "#/$defs/manifestStorage" },
    "deploy": { "$ref": "#/$defs/manifestDeploy" },
    "blocklist": { "$ref": "#/$defs/manifestBlocklist" },
    "discovery": { "$ref": "#/$defs/manifestDiscovery" },
    "log_sink": { "$ref": "#/$defs/manifestLogSink" }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|^[A-Za-z]:|\\\\|(^|/)\\.\\.(/|$)|//)" },
      "description": "Forward slashes only, not absolute, no .. segment."
    },
    "locale": {
      "type": "string",
      "enum": ["en", "zh_CN", "zh_TW", "fr_FR", "es", "de_DE", "ru_RU", "vi_VN", "ko_KR", "tr_TR", "ar", "uk_UA", "ja_JP", "pt_PT"],
      "description": "A language the reference host translates its interface into, see https://nginxui.com/plugin/capabilities/content."
    },
    "manifestI18n": {
      "type": "object",
      "additionalProperties": false,
      "description": "An empty or absent field falls back to the top level one.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "permission": {
      "type": "string",
      "anyOf": [
        { "enum": ["kv", "network", "cron", "notify", "metrics.read", "core_api", "mcp", "cert.deploy", "log.read", "log.files"] },
        { "pattern": "^credentials\\.read:.+$" }
      ]
    },
    "manifestRequirement": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "version": { "type": "string" }
      }
    },
    "manifestCron": {
      "type": "object",
      "required": ["id", "schedule", "method"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schedule": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "manifestServer": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["executables"] },
        { "required": ["command"] }
      ],
      "properties": {
        "executables": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9]+-[a-z0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/safeRelativePath" }
        },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": ["resident", "on_demand"]
        },
        "idle_timeout_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "resources": { "$ref": "#/$defs/manifestResources" }
      }
    },
    "manifestResources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Hints a host that confines plugin processes applies, capped by its own limits, and the memory that suits the plugin.",
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "Memory in MiB. 0 or absent means no hint."
        },
        "cpu_percent": {
          "type": "integer",
          "minimum": 0,
          "description": "CPU time in percent of one core, 100 being one core. 0 or absent means no hint."
        },
        "recommended_memory_mb": {
          "type": "integer",
          "minimum": 0,
          "description": "Memory in MiB the machine, or the container the host runs in, should have for the plugin to work well. Advice only. 0 or absent means no hint."
        }
      }
    },
    "manifestWebapp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundle_path": { "$ref": "#/$defs/safeRelativePath" },
        "style_path": { "$ref": "#/$defs/safeRelativePath" },
        "shared": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestPage" }
        },
        "chunks": {
          "type": "object",
          "description": "Chunk name to a package relative .js file.",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/safeRelativePath" },
              { "pattern": "\\.js$" }
            ]
          }
        }
      },
      "dependentRequired": { "chunks": ["bundle_path"] }
    },
    "manifestPage": {
      "type": "object",
      "required": ["path", "title", "file"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "title": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "icon": { "type": "string" },
        "file": { "$ref": "#/$defs/safeRelativePath" }
      }
    },
    "manifestContent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Process-less contributions: templates and translation files. See https://nginxui.com/plugin/capabilities/content.",
      "properties": {
        "templates": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "A directory holding conf/*.conf and block/*.conf templates."
        },
        "locales": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "A directory holding one <lang>.po file per language."
        }
      }
    },
    "manifestDns01": {
      "type": "object",
      "required": ["providers"],
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dns01Provider" }
        }
      }
    },
    "dns01Provider": {
      "type": "object",
      "required": ["name", "code", "form"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed dns01 plugins may share."
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api": { "type": "string" }
          }
        },
        "propagation_timeout_seconds": { "type": "integer", "minimum": 0 },
        "polling_interval_seconds": { "type": "integer", "minimum": 0 },
        "form": { "$ref": "#/$defs/dns01ProviderForm" }
      }
    },
    "dns01ProviderForm": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "description": "The credential form the host renders for this provider.",
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/dns01ProviderField" },
          "description": "Every value the provider accepts, in display order. Empty when it takes none."
        },
        "methods": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/dns01ProviderMethod" },
          "description": "Present only when there is more than one way to sign in."
        }
      }
    },
    "dns01ProviderField": {
      "type": "object",
      "required": ["key", "label", "group"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1, "description": "The config key the value is stored and sent under." },
        "label": { "type": "string", "minLength": 1, "description": "An English gettext msgid." },
        "help": { "type": "string", "description": "An English gettext msgid." },
        "group": { "type": "string", "enum": ["credential", "setting"] },
        "optional": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "default": { "type": "string" },
        "unit": { "type": "string", "enum": ["", "seconds"] },
        "link": { "type": "string" }
      }
    },
    "dns01ProviderMethod": {
      "type": "object",
      "required": ["name", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "An English gettext msgid." },
        "recommended": { "type": "boolean" },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Keys of credential fields, empty when the method needs none."
        },
        "values": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string" },
          "description": "Fixed config values the host stores while this method is chosen."
        }
      }
    },
    "manifestHttp": {
      "type": "object",
      "required": ["listen"],
      "additionalProperties": false,
      "properties": {
        "listen": {
          "type": "string",
          "enum": ["unix", "rpc"]
        }
      }
    },
    "manifestNotify": {
      "type": "object",
      "required": ["channels"],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/notifyChannel" }
        }
      }
    },
    "notifyChannel": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed notify plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" }
      }
    },
    "manifestProbe": {
      "type": "object",
      "required": ["kinds"],
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/probeKind" }
        }
      }
    },
    "probeKind": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed probe plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" }
      }
    },
    "manifestStorage": {
      "type": "object",
      "required": ["backends"],
      "additionalProperties": false,
      "properties": {
        "backends": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/storageBackend" }
        }
      }
    },
    "storageBackend": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed storage plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" }
      }
    },
    "manifestDeploy": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/deployTarget" }
        }
      }
    },
    "deployTarget": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed cert.deploy plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" }
      }
    },
    "manifestBlocklist": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blocklistSource" }
        }
      }
    },
    "blocklistSource": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed security.blocklist plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" },
        "refresh_seconds": {
          "type": "integer",
          "anyOf": [{ "const": 0 }, { "minimum": 60 }],
          "description": "0 or absent means 3600."
        }
      }
    },
    "manifestDiscovery": {
      "type": "object",
      "required": ["providers"],
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/discoveryProvider" }
        }
      }
    },
    "discoveryProvider": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,32}$",
          "description": "A code no two installed upstream.discovery plugins may share."
        },
        "name": { "type": "string", "minLength": 1 },
        "configuration": { "$ref": "#/$defs/configurationSchema" }
      }
    },
    "manifestLogSink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "0 or absent means 256."
        },
        "flush_interval_ms": {
          "type": "integer",
          "anyOf": [
            { "const": 0 },
            { "minimum": 50 }
          ],
          "description": "0 or absent means 500."
        },
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["combined", "raw"] },
          "uniqueItems": true,
          "description": "Empty or absent means every line."
        }
      }
    },
    "configurationSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/configurationField" }
        }
      }
    },
    "configurationField": {
      "type": "object",
      "required": ["key", "display_name"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["text", "textarea", "number", "bool"],
          "description": "Absent means text."
        },
        "display_name": { "type": "string", "minLength": 1 },
        "help_text": { "type": "string" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" }
      }
    },
    "manifestMcp": {
      "type": "object",
      "required": ["tools"],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mcpTool" }
        }
      }
    },
    "mcpTool": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$",
          "description": "The host publishes it as <id with dots replaced by underscores>__<name>."
        },
        "description": { "type": "string", "minLength": 1 },
        "input_schema": {
          "type": "object",
          "description": "A JSON Schema whose type is object."
        }
      }
    },
    "settingsSchema": {
      "type": "object",
      "required": ["settings"],
      "additionalProperties": false,
      "properties": {
        "header": { "type": "string" },
        "footer": { "type": "string" },
        "settings": {
          "type": "array",
          "items": { "$ref": "#/$defs/settingsField" }
        }
      }
    },
    "settingsField": {
      "type": "object",
      "required": ["key", "type", "display_name"],
      "additionalProperties": false,
      "if": {
        "properties": { "type": { "const": "select" } }
      },
      "then": {
        "required": ["key", "type", "display_name", "options"],
        "properties": {
          "options": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/settingsOption" }
          }
        }
      },
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["text", "bool", "number", "select", "secret", "textarea", "list"]
        },
        "display_name": { "type": "string", "minLength": 1 },
        "help_text": { "type": "string" },
        "default": {},
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/settingsOption" }
        },
        "required": { "type": "boolean" }
      }
    },
    "settingsOption": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
