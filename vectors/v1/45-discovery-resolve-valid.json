{
  "description": "The host resolves a service; the plugin replies with every server that backs it, their weights and how long the answer stays fresh.",
  "method": "discovery.resolve",
  "direction": "host_to_plugin",
  "kind": "request",
  "request": {
    "jsonrpc": "2.0",
    "id": 50,
    "method": "discovery.resolve",
    "params": {
      "provider": "registry",
      "config": { "address": "https://registry.example.com:8500", "token": "tok_live_xxx" },
      "service": "api"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 50,
    "result": {
      "targets": [
        { "address": "10.0.1.12", "port": 8080, "weight": 1, "tags": ["zone-a"] },
        { "address": "10.0.2.7", "port": 8080, "weight": 2, "tags": ["zone-b", "canary"] },
        { "address": "2001:db8::17", "port": 8443 }
      ],
      "ttl_seconds": 30
    }
  }
}
